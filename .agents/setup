#!/usr/bin/env bash
set -euo pipefail

readonly VP_VERSION="0.3.2"
readonly VP_ENV="$HOME/.config/vite-plus/env"

step() {
  printf '\n==> %s\n' "$1"
}

step "Installing Vite+ ${VP_VERSION}"
if [[ "$(readlink "$HOME/.local/share/vite-plus/current" 2>/dev/null || true)" != "$VP_VERSION" ]]; then
  curl -fsSL https://vite.plus | CI=true VP_VERSION="$VP_VERSION" bash
fi

# The installer writes this file but cannot update the current shell itself.
# shellcheck disable=SC1090
. "$VP_ENV"

step "Checking the Node.js runtime"
node_major="$(node --version | sed -E 's/^v([0-9]+).*/\1/')"
if ((node_major < 24)); then
  printf 'Node.js 24 or newer is required; found %s.\n' "$(node --version)" >&2
  exit 1
fi
printf 'Using Node.js %s and Vite+ %s.\n' "$(node --version)" "$(vp --version | sed -n '1p')"

step "Installing locked dependencies"
vp install --frozen-lockfile
